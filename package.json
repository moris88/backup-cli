{
  "name": "backup-script-cli",
  "version": "1.1.1",
  "description": "App desktop per creare ed estrarre backup ZIP cifrati",
  "main": "out/main/index.js",
  "files": [
    "out",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc",
    "lint": "biome check src tests electron.vite.config.ts vitest.config.ts",
    "clean": "rimraf dist out",
    "electron:install": "node node_modules/electron/install.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:electron": "electron-vite build && electron-builder --win --linux --publish never"
  },
  "keywords": [
    "backup",
    "archive",
    "zip",
    "typescript"
  ],
  "author": {
    "name": "Maurizio Tolomeo",
    "email": "maurizio.tolomeo@outlook.it",
    "url": "https://www.mauriziotolomeo.it"
  },
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.18",
    "archiver": "^7.0.1",
    "archiver-zip-encryptable": "^1.0.10",
    "glob": "^13.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.5",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^7.0.0",
    "@types/glob": "^9.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24"
  },
  "build": {
    "appId": "it.mauriziotolomeo.backup",
    "productName": "Backup",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Maurizio Tolomeo <maurizio.tolomeo@outlook.it>"
    }
  },
  "homepage": "https://github.com/moris88/backup-cli"
}
